N = 4

board = [[0] * N for _ in range(N)]


def safe(row, col):

    # Check left side row
    for i in range(col):

        if board[row][i] == 1:
            return False

    # Check upper left diagonal
    i = row
    j = col

    while i >= 0 and j >= 0:

        if board[i][j] == 1:
            return False

        i -= 1
        j -= 1

    # Check lower left diagonal
    i = row
    j = col

    while i < N and j >= 0:

        if board[i][j] == 1:
            return False

        i += 1
        j -= 1

    return True


def solve(col):

    # Base Case
    if col >= N:
        return True

    # Try every row
    for i in range(N):

        if safe(i, col):

            # Place Queen
            board[i][col] = 1

            # Recursive Call
            if solve(col + 1):
                return True

            # Backtracking
            board[i][col] = 0

    return False


# Function Call
solve(0)

# Print Board
for i in board:
    print(i)
